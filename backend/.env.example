# Local development uses ephemeral H2 in-memory storage by default.
# To activate PostgreSQL, set SPRING_PROFILES_ACTIVE=postgres and provide:
SPRING_PROFILES_ACTIVE=
DB_URL=
DB_USERNAME=
DB_PASSWORD=
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Reserved for a future analysis provider. COCO currently uses MockAnalysisProvider.
AI_PROVIDER=
AI_API_URL=
AI_API_KEY=
