# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script
# ----------------------------------------------------------------------------

set -e

findMavenWrapper() {
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    WRAPPER_JAR="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar"
    WRAPPER_PROPERTIES="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.properties"
    
    if [ -r "$WRAPPER_PROPERTIES" ]; then
        while IFS="=" read key value; do
            case "$key" in
                distributionUrl) DISTRIBUTION_URL="$value";;
                wrapperUrl) WRAPPER_URL="$value";;
            esac
        done < "$WRAPPER_PROPERTIES"
    fi
}

findMavenWrapper

if [ ! -r "$WRAPPER_JAR" ]; then
    if ! command -v curl >/dev/null 2>&1; then
        echo "ERROR: 'curl' is required to download the Maven wrapper jar."
        exit 1
    fi
    echo "Downloading Maven Wrapper..."
    mkdir -p "$(dirname "$WRAPPER_JAR")"
    curl -fsSL -o "$WRAPPER_JAR" "$WRAPPER_URL"
fi

exec java -classpath "$WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"
